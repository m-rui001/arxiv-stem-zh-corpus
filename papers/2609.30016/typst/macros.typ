// 2609.30016 共用宏：化学式与常见符号
// 用法：正文里写 #BiSe、#BiF。注意 Typst 里两个相邻的 $...$ 数学块会报 unclosed delimiter，
// 所以同一块内用空格分隔多个带下标的文本串。

#let BiSe = [$"Bi"_2 "Se"_3$]
#let BiF = [$"BiF"_3$]
#let BiOx = [$"BiO"_x$]
#let BiOt = [$"Bi"_2 "O"_3$]
#let MoS = [$"MoS"_2$]
#let WSe = [$"WSe"_2$]
#let SF = [$"SF"_6$]
#let O2 = [$"O"_2$]
#let hBN = [h-BN]
#let aB = [$"a-BiF"_3$]
#let cB = [$"c-Bi"_2 "Se"_3$]
#let EF = [$E _"F"$]
#let ED = [$E _"D"$]
#let Vt = [$V _"th"$]

#let hk = [高-$kappa$]
