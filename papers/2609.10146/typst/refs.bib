  issn = {1558-2515},
  doi = {10.1109/TASC.2016.2631948},
  abstract = {Uniformity in thickness and electronic properties of superconducting niobium titanium nitride (NbTiN) thin films is a critical issue for upscaling superconducting electronics, such as microwave kinetic inductance detectors for submillimeter wave astronomy. In this article we make an experimental comparison between the uniformity of NbTiN thin films produced by two DC magnetron sputtering systems with vastly different target sizes: the Nordiko 2000 equipped with a circular \O{} 100 mm target, and the Evatec LLS801 with a rectangular target of 127 mm \texttimes{} 444.5 mm. In addition to the films deposited staticly in both systems, we have also deposited films in the LLS801 while shuttling the substrate in front of the target, with the aim of further enhancing the uniformity. Among these three setups, the LLS801 system with substrate shuttling has yielded the highest uniformity in film thickness (\textpm 2\%), effective resistivity (decreasing by 5\% from center to edge), and superconducting critical temperature (Tc = 15.0 K-15.3 K) over a \O{} 100 mm wafer. However, the shuttling appears to increase the resistivity by almost a factor of 2 compared to static deposition. Surface SEM inspections suggest that the shuttling could have induced a different mode of microstructural film growth.},
  keywords = {Conductivity,Kinetic inductance detectors,Microwave circuits,Niobium,reactive sputtering,Resonant frequency,Sputtering,superconducting device fabrication,Superconducting microwave devices,superconducting thin films,Superconducting transmission lines},
