  journal = {Appl. Phys. Lett.},
  volume = {119},
  number = {9},
  pages = {092601},
  publisher = {American Institute of Physics},
  issn = {0003-6951},
  doi = {10.1063/5.0058335},
  urldate = {2023-02-20},
  abstract = {One of the advantages of kinetic inductance detectors is their intrinsic frequency domain multiplexing capability. However, fabrication imperfections usually give rise to resonance frequency deviations, which create frequency collision and limit the array yield. Here, we study the resonance frequency deviation of a 4-in. kilo-pixel lumped-element kinetic inductance detector (LEKID) array using optical mapping. Using the measured resonator dimensions and film thickness, the fractional deviation can be explained within  \textpm 25\texttimes{} 10 -3 \textpm{} 25 \texttimes{} 10 - 3 , whereas the residual deviation is due to variation of electric film properties. Using the capacitor trimming technique, the fractional deviation is decreased by a factor of 14. The yield of the trimming process is found to be 97\%. The mapping yield, measured under a 110\,K background, is improved from 69\% to 76\%, which can be further improved to 81\% after updating our readout system. With the improvement in yield, the capacitor trimming technique may benefit future large-format LEKID arrays.},
  file = {C:\Users\wilbertr\Zotero\storage\4VVLJ6M5\Shu et al. - 2021 - Understanding and minimizing resonance frequency d.pdf}
}

