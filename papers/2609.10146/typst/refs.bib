}

@misc{scholtenhuisEnhancedElectronbeamLithography2026,
  title = {Enhanced Electron-Beam Lithography to Reduce the Frequency Scatter of 200-400 {{GHz}} Superconducting Microstrip Resonators for on-Chip Filterbank Spectrometers},
  author = {Olde Scholtenhuis, L. G. G. and Thoen, D. J. and Baselmans, J. J. A. and Karatsu, K. and Martin, L. H. and Vollebregt, S. and Endo, A.},
