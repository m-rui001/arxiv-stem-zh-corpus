}

@article{shuIncreasedMultiplexingSuperconducting2018,
  title = {Increased Multiplexing of Superconducting Microresonator Arrays by Post-Characterization Adaptation of the on-Chip Capacitors},
  author = {Shu, S. and Calvo, M. and Goupy, J. and Leclercq, S. and Catalano, A. and Bideaud, A. and Monfardini, A. and Driessen, E. F. C.},
