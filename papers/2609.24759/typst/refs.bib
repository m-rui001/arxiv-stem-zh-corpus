  note   = {The longitudinal coupling strength to flux noise is given by $\mathcal{N}_\mathrm{DP}^\mathrm{Flux}=\vert 2\mathcal{I}_1\mathcal{F}(\phi_\mathrm{ext}/2) [-\langle \psi_0\vert\cos(\phi)\vert\psi_0\rangle +\langle \psi_1\vert\cos(\phi)\vert\psi_1\rangle] + \mathcal{I}_2\mathcal{F}(\phi_\mathrm{ext}) [-\langle \psi_0\vert\cos(2\phi)\vert\psi_0\rangle +\langle \psi_1\vert\cos(2\phi)\vert\psi_1\rangle]\vert^2$. Here, $\mathcal{F}(x)=-\sin(x)\cos(x)/\vert \cos(x) \vert$.},
  groups = {Note},
}
