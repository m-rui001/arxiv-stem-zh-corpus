@article{gearyCryogenicWaferProber1983,
  title = {Cryogenic Wafer Prober for {{Josephson}} Devices},
  author = {Geary, J. and {Vella-Coleiro}, G.},
  year = 1983,
  month = may,
  journal = {IEEE Transactions on Magnetics},
  volume = {19},
  number = {3},
  pages = {1190--1192},
  issn = {1941-0069},
  doi = {10.1109/TMAG.1983.1062335},
  url = {https://ieeexplore.ieee.org/abstract/document/1062335?casa_token=SgB8YiWZsogAAAAA:I_cMET999krAtBIVLgl2qDjZJTlLESFHX7hqXrUbAeFF979wVAA8dBNivTPK30A_JXeYTKHliuk},
  urldate = {2024-11-21},
  abstract = {A wafer probing system has been built for the testing of Josephson junction devices at helium temperature. A mechanism moves a probe card from one position to another on a two inch wafer while immersed in liquid helium. The mechanism is actuated by shafts which connect to stepper motors positioned above the helium dewar. A positioning accuracy of \textpm{} 50 {$\mu$} m at the probe tips is achieved. The replaceable probe card is all ceramic and carries 120 rigidly mounted palladium-alloy needles, arranged in signal-ground pairs and positioned in an array which matches the pad design of the particular device under test. Controlled impedance transmission lines are maintained all the way to the wafer's surface. A computer interface is included so that probing of a whole wafer can be conducted under software control. The system is intended for routine testing of Josephson devices in wafer form as well as for testing very large numbers of individual junctions.},
  keywords = {Ceramics,Cryogenics,Josephson junctions,Needles,Probes,Shafts,Superconducting devices,System testing,Temperature},
  file = {C\:\\Users\\llelas\\Zotero\\storage\\NGB5ZH5Y\\Geary and Vella-Coleiro - 1983 - Cryogenic wafer prober for Josephson devices.pdf;C\:\\Users\\llelas\\Zotero\\storage\\F8WHSWZG\\1062335.html}
}

@article{abelsonManufacturabilitySuperconductorElectronics1999,
  title = {Manufacturability of Superconductor Electronics for a Petaflops-Scale Computer},
  author = {Abelson, L.A. and Herr, Q.P. and Kerber, G.L. and Leung, M. and Tighe, T.S.},
  year = 1999,
  month = jun,
  journal = {IEEE Transactions on Applied Superconductivity},
  volume = {9},
  number = {2},
  pages = {3202--3207},
  issn = {1558-2515},
