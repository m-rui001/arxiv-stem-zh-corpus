@article{samaniMicrokelvinElectronicsPulsetube2022,
  title = {Microkelvin Electronics on a Pulse-Tube Cryostat with a Gate {{Coulomb-blockade}} Thermometer},
  author = {Samani, Mohammad and Scheller, Christian P. and Sedeh, Omid Sharifi and Zumb{\"u}hl, Dominik M. and Yurttag{\"u}l, Nikolai and Grigoras, Kestutis and Gunnarsson, David and Prunnila, Mika and Jones, Alexander T. and Prance, Jonathan R. and Haley, Richard P.},
