@article{iwabuchiDevelopmentVickerstypeHardness1996,
  title = {The Development of a {{Vickers-type}} Hardness Tester for Cryogenic Temperatures down to 4.2 {{K}}},
  author = {Iwabuchi, A. and Shimizu, T. and Yoshino, Y. and Abe, T. and Katagiri, K. and Nitta, I. and Sadamori, K.},
