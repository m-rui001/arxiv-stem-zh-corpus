  author = {H{\"a}tinen, J. and Ronzani, A. and Loreto, R.P. and Mykk{\"a}nen, E. and Kemppinen, A. and Viisanen, K. and Rantanen, T. and Geisor, J. and Lehtinen, J.S. and Ribeiro, M. and Kaikkonen, J-P. and Prakash, O. and Vesterinen, V. and F{\"o}rbom, C. and Mannila, E.T. and Kervinen, M. and Govenius, J. and Prunnila, M.},
