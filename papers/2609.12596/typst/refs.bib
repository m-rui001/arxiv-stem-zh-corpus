  author = {West, Joshua T. and Kurlej, Arthur and Wynn, Alex and Rogers, Chad and Gouker, Mark A. and Tolpygo, Sergey K.},
  year = 2022,
  month = aug,
  journal = {IEEE Transactions on Applied Superconductivity},
  volume = {32},
  number = {5},
  pages = {1--12},
