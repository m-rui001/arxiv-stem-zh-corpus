  urldate = {2025-10-20},
  abstract = {Linear conduction backgrounds, which have been emphasized recently in connection with tunneling measurements of the high-Tc superconductors, are actually quite general. We argue that they may be due to inelastic tunneling from a broad distribution of states. This view is supported by: 1) the temperature dependence of this background; 2) quantitative analysis of Pb phonon features using the inelastic hypothesis; and 3) measurements of Al--AlOx--Pb junctions with CrOx included in the barrier region, which show that the background arises from interactions in the tunneling barrier. Suppression of the Al gap signature, and magnetic field dependent modifications of the conductance background, indicate a spin-dependent interaction mechanism in Al--CrOx--Pb junctions. The observation of the linear background out to very large voltages may be indicative of multiple scattering in the tunneling process. Monte Carlo calculations of strong multiple scattering inelastic tunneling are presented to explore this possibility.},
  file = {C\:\\Users\\llelas\\Zotero\\storage\\HPI7FQS8\\Kirtley et al. - 1992 - Linear conductance backgrounds in tunnel junctions.pdf;C\:\\Users\\llelas\\Zotero\\storage\\HEYFET3G\\Linear-conductance-backgrounds-in-tunnel-junctions.html}
}

