	pages = {58},
	file = {Texte intégral:C\:\\Users\\johan.pelloux-prayer\\Zotero\\storage\\932AAEKK\\Meunier et al. - 2025 - Silicon spin qubits a viable path towards industrial manufacturing of large-scale quantum processor.pdf:application/pdf},
}

